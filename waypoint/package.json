{
  "name": "waypoint",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types lib/*.test.ts",
    "migrate": "node --env-file=.env.local --experimental-strip-types scripts/migrate.ts",
    "seed": "node --env-file=.env.local --experimental-strip-types scripts/seed.ts",
    "e2e": "node --env-file=.env.local --test --test-concurrency=1 e2e/app.test.mjs",
    "bench": "node --env-file=.env.local --experimental-strip-types scripts/bench.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@clickhouse/client": "^1.23.1",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
